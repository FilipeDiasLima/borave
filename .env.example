# Copie para `.env.local` e preencha. Nunca commite valores reais.

# Postgres (dev: Neon). Console do Neon → projeto → Connection string.
DATABASE_URL=

# Segredo que assina as sessões do Better Auth (32+ caracteres aleatórios).
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL base da aplicação. Local: http://localhost:3000
BETTER_AUTH_URL=

# OAuth do Google. Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth (aplicativo da Web).
# URI de redirecionamento autorizado: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
